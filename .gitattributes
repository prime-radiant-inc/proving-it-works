# Text is LF everywhere, Windows checkouts included: movie embeds text files
# (overlay.js), so CRLF would change the binaries the release check compares.
* text=auto eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.ttf binary
skills/proving-it-works-with-a-movie/bin/movie text eol=lf
skills/proving-it-works-with-a-movie/bin/movie.ps1 text eol=lf
skills/proving-it-works-with-a-movie/bin/VERSION text eol=lf
skills/proving-it-works-with-a-movie/bin/checksums.txt text eol=lf
